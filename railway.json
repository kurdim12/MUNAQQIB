{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/worker/Dockerfile"
  },
  "deploy": {
    "startCommand": "sh scripts/daily.sh",
    "cronSchedule": "30 4 * * *",
    "restartPolicyType": "NEVER",
    "numReplicas": 1
  }
}
