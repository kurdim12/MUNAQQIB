# ============================================================================
# MUNAQQIB (منقّب) — environment template.  Copy to .env and fill in.
# NEVER commit a real .env.  Secrets only via env vars (CLAUDE.md §1.5).
# ============================================================================

# --- Database: Cloudflare D1 (DECISIONS.md 2026-06-12) ----------------------
# The worker talks to D1 via the Cloudflare REST API (or a Workers binding).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=                 # scoped to D1 (read/write) + R2
D1_DATABASE_ID=c296c699-1053-4e95-8d4b-602dca9e18c1   # munaqqib (region EEUR)
# Cloudflare R2 for HTML snapshots + uploaded كراسات (replaces Supabase Storage).
R2_BUCKET=munaqqib-snapshots
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=                          # https://<account>.r2.cloudflarestorage.com

# --- Supabase (legacy / optional) -------------------------------------------
# Retained only for reference and a possible Auth-only role in Phase 1. The
# Postgres migration lives at supabase/migrations/0001_init.sql. Not used for the
# primary datastore now that the DB is on Cloudflare D1.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=snapshots

# --- LLM: Anthropic direct (analyzer pass-2 / eligibility — never downgrade) -
ANTHROPIC_API_KEY=

# --- LLM: OpenRouter (cheap-model slots: pass-1, fallback extractor, awards) -
OPENROUTER_API_KEY=
# Per-task model config consumed by llm_client.py.  Pin providers w/ no-train/ZDR.
LLM_PASS1_MODEL=deepseek/deepseek-chat
LLM_PASS2_MODEL=claude-sonnet-4-6
LLM_FALLBACK_MODEL=deepseek/deepseek-chat

# --- Delivery: Email (Resend) ----------------------------------------------
RESEND_API_KEY=
# Until your domain is verified in Resend, use its shared sender (test mode
# delivers ONLY to your Resend account email). After verifying a domain, switch
# to EMAIL_FROM=digest@yourdomain to send to anyone.
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=منقّب
PUBLIC_BASE_URL=https://app.yourdomain   # used for "التفاصيل"/dashboard links

# --- Delivery: Telegram (instant alerts + founder ops) ---------------------
TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# --- Phase 0 only -----------------------------------------------------------
PARTNER_PROFILE_PATH=partner_profile.yaml

# --- Scraper identity / politeness (CLAUDE.md §7, §14) ----------------------
SCRAPER_USER_AGENT=MunaqqibBot/0.1 (+abdalrhmankurdi12@gmail.com)
SCRAPER_RATE_LIMIT_RPS=1
# Reader-proxy fallback for sources that bot-wall non-Jordanian datacenter IPs
# (GTD serves a 54-byte empty shell to cloud hosts). Fetches server-side and
# returns HTML. Public reader, no secret. Set empty to disable the fallback.
SCRAPER_READER_PROXY=https://r.jina.ai/

# --- Web app (apps/web) -----------------------------------------------------
# Reads/writes D1 via the same CLOUDFLARE_* + D1_DATABASE_ID vars above.
# Until an auth provider is chosen, the dashboard's "current org" falls back to
# this id when no org_id cookie is set (temporary dev seam — DECISIONS.md).
DEMO_ORG_ID=
# CliQ alias customers transfer to when upgrading (manual payment confirmation).
CLIQ_ALIAS=

# --- Auth.js (NextAuth v5) — passwordless email magic-links via Resend --------
# Without AUTH_SECRET the app degrades to the dev org seam (no login required).
AUTH_SECRET=                          # openssl rand -base64 32
AUTH_RESEND_KEY=                      # Resend key for magic-links (falls back to RESEND_API_KEY)
# EMAIL_FROM (above) is reused as the magic-link sender. AUTH_URL only needed if
# not auto-detected; trustHost is enabled for Vercel/Node deploys.
AUTH_URL=
# Platform-admin emails (comma-separated) — can confirm CliQ payments at /admin.
ADMIN_EMAILS=

# --- Misc -------------------------------------------------------------------
TZ=Asia/Amman
LOG_LEVEL=INFO
